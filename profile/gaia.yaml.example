# Gaia orchestrator settings
#
# Lives at $HERMES_HOME/gaia.yaml (for the "gaia" profile that is
# ~/.hermes/profiles/gaia/gaia.yaml). install.sh writes this file for you;
# edit it by hand any time — the scripts read it on every call.

claude:
  # "local"  -> Claude Code is installed on the same machine as Hermes
  # "ssh"    -> Claude Code lives on another machine reachable over SSH
  mode: local

  # Path to (or name of) the `claude` binary ON THE CLAUDE CODE HOST.
  bin: claude

  # Only used when mode == ssh. Key-based, non-interactive login required.
  ssh_host: ""              # e.g. julien@um890.local
  ssh_opts: "-o BatchMode=yes -o ConnectTimeout=10"

  # Optional overrides passed to every `claude -p` run. Leave empty for defaults.
  model: ""                 # e.g. claude-sonnet-4-5 / claude-opus-4-1
  max_turns: 300            # safety cap per headless run
  max_budget_usd: 0         # 0 = no cap (API-key auth only; ignored on subscriptions)

# Root directory for new projects ON THE CLAUDE CODE HOST. `~` is expanded there.
projects_root: ~/projects

github:
  # Leave both empty and Gaia asks the stakeholder per project (recommended).
  default_org: ""           # e.g. gaiastudio-ai   (empty = personal account / ask)
  default_visibility: ""    # private | public | internal (empty = ask)

stakeholder:
  name: ""                  # how Gaia addresses you, e.g. "Julien"
  timezone: ""              # e.g. Europe/Berlin — used when Gaia reports times

notify:
  # Where interrupts go. Hermes' gateway decides the actual transport;
  # this only tells Gaia which events are worth an interrupt.
  on_stakeholder_question: true
  on_phase_complete: true
  on_gate_rejection: true
  on_failure: true
  on_progress: false        # true = chatty; every completed GAIA command pings you

lifecycle:
  # Which phases Gaia runs autonomously after /gaia-init. Set one to false to
  # make Gaia stop and ask before starting it.
  autonomous:
    analysis: true          # /gaia-brainstorm, research
    planning: true          # /gaia-create-prd, /gaia-create-ux
    solutioning: true       # /gaia-create-arch, /gaia-create-epics, readiness
    implementation: true    # sprint-plan -> create-story -> dev-story -> review-all -> sprint-close
    deployment: false       # deploy checklists touch real infrastructure: ask first
  # Holds. A hold STOPS the loop, puts a document in front of the stakeholder,
  # and nothing proceeds until they answer. It is not a notification: a phase
  # that was "notified" completed and continued (Portfolio Agents, Sept 2026 —
  # a PRD, eighteen architecture revisions and a merge to main with nobody
  # asked). Both default to ON. Turning one off is a decision: say why here.
  holds:
    product_brief: true     # after the brief, when Gaia authored it from research. Skipped —
                            # and the skip recorded with its reason — when the stakeholder
                            # supplied the brief themselves.
    implementation: true    # before any story runs: the PRD and the architecture together,
                            # with the readiness verdict on the card. No story until approved.
  # How many times Gaia retries a failing story/review before escalating.
  max_gate_retries: 3

# Where a hold is presented and answered. The hold itself lives in the project
# file either way; the backend is only the transport.
#   channel  -> Gaia sends the card text on its messaging channel and records an
#               open stakeholder question; the stakeholder answers by replying
#               approve / send back / stop and Gaia records it (gaia-hold.sh answer).
#   command  -> Gaia runs hold_commands.file with HOLD_SLUG, HOLD_NAME, HOLD_REF,
#               HOLD_SENDER, HOLD_SUBJECT, HOLD_ASK and HOLD_ARTIFACTS in the
#               environment; the command files the hold somewhere durable (a row,
#               a card with buttons, a re-send schedule, a dashboard entry) and
#               prints an id. Gaia then runs hold_commands.status with HOLD_ID and
#               reads one line: pending | decided:<answer> | withdrawn.
hold_backend: channel
hold_commands:
  file: ""                  # e.g. "vera-founder-gate hold-file"
  status: ""                # e.g. "vera-founder-gate status $HOLD_ID"
